{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Galaxy Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ],
            "preLaunchTask": "npm: build"
        },
        {
            "name": "Attach to Engine",
            "type": "node",
            "request": "attach",
            "port": 5858,
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ]
        }
    ]
}